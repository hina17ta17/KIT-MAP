# ===============================================================
# 置き場に入れないもの
# ===============================================================
# ここに書いていないものは、すべて置き場に入る。
# 鍵は必ず .env.local に書く（一度でも置き場に入れると、消しても履歴に残る）。

# ---------------------------------------------------------------- 鍵
.env*
*.pem
*.key
*.p12
# 攻撃の検査（エージェントガード）の鍵の置き場と、組み込みの道具
/.agentguard/
/agentguard-setup*/

# ---------------------------------------------------------------- 名簿・大学の文書
# 個人の情報（学籍番号・氏名）が入るものを、うっかり入れないための保険
*.xlsx
*.xls
*.csv
*.doc
*.docx
*.pdf

# ---------------------------------------------------------------- 作られるもの
/node_modules
/.next/
/coverage/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# ---------------------------------------------------------------- 地図データの元と控え
# 公開しているのは public/data/ の GeoJSON だけ
/public/data/base/
/public/data/walk3d/
/raw/
/tizu/
*.zip
/*.geojson

# ---------------------------------------------------------------- 手元だけの道具と覚え書き
# 作図ツール・診断画面・申請の割り振り（Python）・一度きりの道具
/app/edit/
/app/api/publish/
/app/test/
/components/MapEditor.tsx
/components/EditorOverlay.tsx
/lib/fgd.ts
/agent/
# ★ copy-maplibre-worker.mjs は外さない（組み立ての前に走る。無いとサイトが出ない）
/scripts/*
!/scripts/copy-maplibre-worker.mjs
# 覚え書き（いちばん上の .md は README.md 以外すべて・docs/）
/docs/
/*.md
!/README.md

# ---------------------------------------------------------------- 役目を終えたもの
/使わないsql/
/supabase/

# ---------------------------------------------------------------- データベースの定義（公開版）
#
# 表・行ごとの決まり（RLS）・関数の SQL は、守りの仕組みそのものなので公開しない。
# 手元の base/ に置いて、ここでは追跡しない。ほかの場所の .sql も入れない。
/base/
*.sql

# ===============================================================
# GitHub（非公開）に置くもの・置かないもの
# ===============================================================
#
# ■ 方針
#   「配って動かすのに要るものだけ」を置く。
#   手元だけで使う道具や資料は、消さずに残したまま、追跡から外す。
#
# ■ 置かないもの
#   ① 鍵（.env*）…… 一度入れると履歴に残り、消しても残る
#   ② 作られるもの（node_modules・.next など）…… 手元で作り直せる
#   ③ 手元だけの道具（作図ツール・点検・エージェント・資料）
#   ④ 役目を終えたもの（古い SQL の束）
#
# ■ 書いていないものは「置く」
#   ここに無いものは、全部 GitHub に入る。
#   新しく鍵を置くときは、必ず .env.local の中に書くこと。

# ---------------------------------------------------------------- 鍵
#
# ★ここだけは絶対に外せない。
#   .env* は、実際のキーが入るファイル。一度でも入れると履歴に残り、
#   あとから消しても残る。*.pem は証明書の鍵。間違って足さないための保険。
.env*
*.pem
*.key
*.p12

# エージェントガードの鍵の置き場と、組み込みの道具。
#   .agentguard/ は、中の .gitignore（*）でも外れている。それが消えたり
#   作り直されたりしても鍵が入らないよう、ここでも外す。
#   agentguard-setup-kit-map/ は、中の一部のフォルダの .gitignore でしか
#   外れていなかった。すぐ下に新しいファイルを置くと追跡されてしまうので、
#   丸ごと外す（2026-11-06 に確かめて足した）。
/.agentguard/
/agentguard-setup-kit-map/

# ---------------------------------------------------------------- 名簿と大学の文書
#
# 名簿（学籍番号・氏名）や、大学から受け取った文書を、うっかり入れないための保険。
#   名簿の取り込み（xlsx）、学科・課外活動の元になった Word の文書など。
#   いま追跡しているものは無い。要るものは、中身を確かめてから個別に足す。
*.xlsx
*.xls
*.csv
*.doc
*.docx
*.pdf

# ---------------------------------------------------------------- 作られるもの
#
# どれも手元で作り直せる。置くと重くなるだけ。
/node_modules
/.next/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# 経路を引き直すための土台データ。
# `npm run dev` のたびに作り直されるので、置いておかなくても困らない。
/public/data/base/

# 3D散策の道の土台（3D散策は 2026-10-30 に中止。残すか消すかは利用者が決める）。
# 外していないと、まとめて足したときに入ってしまうので外す。中身には触らない。
/public/data/walk3d/

# 基盤地図情報の生データ（1メッシュ90MB超。変換後の GeoJSON だけ追跡する）
/raw/
*.zip

# 作図ツールから書き出した控え。公開している public/data/ が本物。
/tizu/
/*.geojson

# ---------------------------------------------------------------- 手元だけで使うもの
#
# 下はどれも手元に残っているが、配って動かすのには要らない。

# 申請を割り振るエージェント（Python）。settings.py に学校のドメインを書く
/agent/

# 作図ツール。地図データを描くときだけ使う
/app/edit/
/app/api/publish/
/components/MapEditor.tsx
/components/EditorOverlay.tsx
/lib/fgd.ts

# 地図が出ないときの診断画面
/app/test/

# 一度きりの道具（取り込み・点検）
#
# ★ copy-maplibre-worker.mjs だけは外さない。
#   package.json の prebuild から呼ばれる。無いと組み立てが止まり、
#   サイトごと出なくなる。
/scripts/*
!/scripts/copy-maplibre-worker.mjs

# 設計と手順の覚え書き
/docs/
/AGENTS.md
/CLAUDE.md
/USAGE.md
/手元メモ.md
/仕組みの構成.md
/ファイルの構成図.md
/機能の一覧.md
/KITmapのすべて.md
/データベースの構成.md

# ---------------------------------------------------------------- 役目を終えたもの
#
# 消さずに手元には残してあるが、追跡はしない。
# いま流しているのは base/ のほう。

# 新しいものに置き換わった SQL。もう流してはいけない
/使わないsql/

# 古いデータベース定義と、その移行ファイル。base/ が本命
/supabase/

# ---------------------------------------------------------------- データベースの定義（公開版）
#
# 表・行ごとの決まり（RLS）・関数の SQL は、守りの仕組みそのものなので公開しない。
# 手元の base/ に置いて、ここでは追跡しない。ほかの場所の .sql も入れない。
/base/
*.sql
